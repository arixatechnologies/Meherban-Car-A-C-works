# Supabase PostgreSQL demo setup:
# DATABASE_URL is used by the running Next.js app.
# For Vercel/serverless demo, use the Supabase Supavisor Transaction pooler URL on port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# DIRECT_URL is used by Prisma CLI migrations/seeding.
# Use Supabase Direct connection if your machine supports IPv6 or you have Supabase IPv4 add-on.
# Otherwise use the Supabase Supavisor Session pooler URL on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Keep low on Vercel/serverless; increase later on Hostinger VPS if needed.
DATABASE_POOL_MAX="1"

NEXTAUTH_SECRET="replace-this-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
