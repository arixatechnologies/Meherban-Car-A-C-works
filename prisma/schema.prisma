generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SERVICE_ADVISOR
  TECHNICIAN
  BILLING_STAFF
}

enum JobCardStatus {
  VEHICLE_RECEIVED
  INSPECTION_STARTED
  ISSUE_DIAGNOSED
  ESTIMATE_SHARED
  WAITING_FOR_CUSTOMER_APPROVAL
  CUSTOMER_APPROVED
  WORK_IN_PROGRESS
  PARTS_REQUIRED
  AC_GAS_FILLING
  COOLING_TEST
  QUALITY_CHECK
  READY_FOR_DELIVERY
  INVOICE_GENERATED
  PAYMENT_PENDING
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InspectionStatus {
  OK
  ATTENTION
  NOT_OK
}

enum EstimateStatus {
  DRAFT
  SHARED
  APPROVED
  REJECTED
  NEEDS_REVISION
  CONVERTED_TO_INVOICE
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT_PAY_LATER
}

enum WhatsAppStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  MANUAL
}

enum WhatsAppMessageType {
  JOB_CARD_CREATED
  INSPECTION_COMPLETED
  ESTIMATE_SHARED
  APPROVAL_REMINDER
  WORK_STARTED
  VEHICLE_READY
  INVOICE_GENERATED
  PAYMENT_REMINDER
  VEHICLE_DELIVERED
  FEEDBACK_REQUEST
  CUSTOM
}

enum WhatsAppSendMethod {
  API
  MANUAL
  FALLBACK
}

enum ItemCategory {
  SERVICE
  PARTS
  LABOUR
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(SERVICE_ADVISOR)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  advisedJobCards   JobCard[]          @relation("ServiceAdvisorJobCards")
  statusLogs        JobCardStatusLog[]
  collectedPayments Payment[]
  estimates         Estimate[]         @relation("EstimateAdvisor")
  invoices          Invoice[]          @relation("InvoiceAdvisor")
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  mobile       String        @unique
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vehicles     Vehicle[]
  jobCards     JobCard[]
  estimates    Estimate[]
  invoices     Invoice[]
  payments     Payment[]
  whatsappLogs WhatsAppLog[]

  @@index([mobile])
  @@index([name])
}

model Vehicle {
  id                  String     @id @default(cuid())
  customerId          String
  vehicleNumber       String     @unique
  brand               String
  model               String
  variant             String?
  fuelType            String
  year                Int?
  odometerReading     Int?
  chassisNumber       String?
  engineNumber        String?
  notes               String?
  nextServiceReminder DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  customer            Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  jobCards            JobCard[]
  estimates           Estimate[]
  invoices            Invoice[]

  @@index([vehicleNumber])
  @@index([customerId])
}

model JobCard {
  id                    String                      @id @default(cuid())
  jobCardNumber         String                      @unique
  dateTime              DateTime                    @default(now())
  customerId            String
  vehicleId             String
  serviceAdvisorId      String?
  serviceAdvisorName    String?
  assignedTechnicianId  String?
  technicianName        String?
  bayNumber             String?
  expectedDeliveryAt    DateTime?
  priority              Priority                    @default(NORMAL)
  trackingToken         String                      @unique
  complaints            String[]
  customComplaint       String?
  problemFound          String?
  workSuggested         String?
  partsRequired         String?
  serviceRecommendation String?
  internalNotes         String?
  finalQcBy             String?
  estimatedTotalAmount  Decimal                     @default(0) @db.Decimal(12, 2)
  advanceAmount         Decimal                     @default(0) @db.Decimal(12, 2)
  balanceDue            Decimal                     @default(0) @db.Decimal(12, 2)
  paymentMode           PaymentMode?
  status                JobCardStatus               @default(VEHICLE_RECEIVED)
  deliveredAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  customer              Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle               Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceAdvisor        User?                       @relation("ServiceAdvisorJobCards", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)
  assignedTechnician    Staff?                      @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  inspectionItems       JobCardInspectionItem[]
  serviceObservations   JobCardServiceObservation[]
  photos                JobCardPhoto[]
  statusLogs            JobCardStatusLog[]
  estimates             Estimate[]
  invoices              Invoice[]
  whatsappLogs          WhatsAppLog[]

  @@index([jobCardNumber])
  @@index([trackingToken])
  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
}

model JobCardServiceObservation {
  id          String   @id @default(cuid())
  jobCardId   String
  sortOrder   Int      @default(0)
  partService String
  description String?
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model JobCardInspectionItem {
  id        String           @id @default(cuid())
  jobCardId String
  name      String
  status    InspectionStatus @default(OK)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  jobCard   JobCard          @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model JobCardPhoto {
  id        String   @id @default(cuid())
  jobCardId String
  type      String
  url       String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model JobCardStatusLog {
  id          String         @id @default(cuid())
  jobCardId   String
  oldStatus   JobCardStatus?
  newStatus   JobCardStatus
  updatedById String?
  remarks     String?
  createdAt   DateTime       @default(now())
  jobCard     JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  updatedBy   User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([jobCardId])
  @@index([newStatus])
}

model Estimate {
  id               String         @id @default(cuid())
  estimateNumber   String         @unique
  jobCardId        String
  customerId       String
  vehicleId        String
  date             DateTime       @default(now())
  validTill        DateTime?
  serviceAdvisorId String?
  problemSummary   String
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal        @default(0) @db.Decimal(12, 2)
  advanceReceived  Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount    Decimal        @default(0) @db.Decimal(12, 2)
  status           EstimateStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  jobCard          JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceAdvisor   User?          @relation("EstimateAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)
  items            EstimateItem[]
  invoices         Invoice[]
  whatsappLogs     WhatsAppLog[]

  @@index([estimateNumber])
  @@index([status])
  @@index([jobCardId])
}

model EstimateItem {
  id          String       @id @default(cuid())
  estimateId  String
  partService String?
  description String
  remarks     String?
  category    ItemCategory
  quantity    Decimal      @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  amount      Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  estimate    Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model Invoice {
  id               String               @id @default(cuid())
  invoiceNumber    String               @unique
  jobCardId        String
  estimateId       String?
  customerId       String
  vehicleId        String
  invoiceDate      DateTime             @default(now())
  serviceAdvisorId String?
  discount         Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal              @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal              @default(0) @db.Decimal(12, 2)
  balanceAmount    Decimal              @default(0) @db.Decimal(12, 2)
  paymentStatus    InvoicePaymentStatus @default(UNPAID)
  deliveryStatus   String               @default("Pending")
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  jobCard          JobCard              @relation(fields: [jobCardId], references: [id], onDelete: Restrict)
  estimate         Estimate?            @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle          Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceAdvisor   User?                @relation("InvoiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]
  whatsappLogs     WhatsAppLog[]

  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([jobCardId])
  @@index([estimateId])
}

model InvoiceItem {
  id          String       @id @default(cuid())
  invoiceId   String
  partService String?
  description String
  remarks     String?
  category    ItemCategory
  quantity    Decimal      @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  amount      Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id              String      @id @default(cuid())
  invoiceId       String
  customerId      String
  amount          Decimal     @db.Decimal(12, 2)
  mode            PaymentMode
  paymentDate     DateTime    @default(now())
  referenceNumber String?
  notes           String?
  collectedById   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  collectedBy     User?       @relation(fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

model WhatsAppLog {
  id            String              @id @default(cuid())
  customerId    String?
  jobCardId     String?
  estimateId    String?
  invoiceId     String?
  mobileNumber  String
  messageType   WhatsAppMessageType
  messageBody   String
  sendMethod    WhatsAppSendMethod
  apiMessageId  String?             @unique
  apiResponse   Json?
  webhookStatus String?
  status        WhatsAppStatus      @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobCard       JobCard?            @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  estimate      Estimate?           @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([mobileNumber])
  @@index([apiMessageId])
  @@index([status])
  @@index([messageType])
}

model Staff {
  id             String      @id @default(cuid())
  name           String
  mobile         String
  email          String?     @unique
  role           UserRole
  status         StaffStatus @default(ACTIVE)
  specialization String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  assignedJobs   JobCard[]

  @@index([mobile])
  @@index([role])
  @@index([status])
}

model WorkshopSetting {
  id                           String   @id @default(cuid())
  singletonKey                 String   @unique @default("default")
  workshopName                 String   @default("Meharban Car A/C Works")
  tagline                      String   @default("Complete Car A/C Service & Repair Specialist")
  phoneNumber                  String   @default("")
  whatsappNumber               String   @default("")
  email                        String   @default("")
  address                      String   @default("")
  logoUrl                      String?
  invoiceFooterNote            String   @default("Thank you for choosing Meharban Car A/C Works. Drive cool, drive comfortable.")
  estimateTerms                String   @default("This is an estimate only. Final invoice may vary if additional parts or services are required after customer approval.")
  jobCardTerms                 String   @default("Customer approval is required before additional work is started.")
  currencySymbol               String   @default("₹")
  jobCardPrefix                String   @default("JC")
  estimatePrefix               String   @default("EST")
  invoicePrefix                String   @default("INV")
  enableWhatsAppApiSending     Boolean  @default(false)
  enableManualWhatsAppFallback Boolean  @default(true)
  autoSendJobCardMessage       Boolean  @default(false)
  autoSendEstimateMessage      Boolean  @default(false)
  autoSendInvoiceMessage       Boolean  @default(false)
  autoSendDeliveryMessage      Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}
